# ---------------------------------------------------------------------------
# Cognis — variáveis de ambiente. Copie para .env.local e preencha.
# NUNCA commite valores reais. Variáveis NEXT_PUBLIC_* ficam visíveis no navegador.
# ---------------------------------------------------------------------------

# URL pública do site (metadados, sitemap, links de confirmação de e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres. Em produção: string de conexão do Supabase (Project Settings → Database).
# Use o pooler em modo transação (porta 6543) em ambientes serverless como a Vercel.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cognis
# DATABASE_SSL=disable|require  (padrão: sem TLS para localhost, TLS para hosts remotos)
# DATABASE_SSL_CA=              (opcional: certificado CA do Supabase para verificação completa)
# DATABASE_POOL_MAX=5

# Supabase Auth (se ausentes, o app usa autenticação local — apenas desenvolvimento)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor. Necessária para excluir contas (auth.admin.deleteUser).
SUPABASE_SERVICE_ROLE_KEY=

# E-mails promovidos a administrador ao entrar (separados por vírgula)
ADMIN_EMAILS=

# Autenticação local (sem Supabase): segredo para assinar sessões.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Permite autenticação local em build de produção (apenas testes/ensaios; não use em produção real)
# COGNIS_ALLOW_LOCAL_AUTH=true
